apiVersion: apps/v1
kind: Deployment
metadata:
  name: mongodb-deploy-user7
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mongodb
  template:
    metadata:
      labels:
        app: mongodb
    spec:
      containers:
      - name: mongodb-container
        image: mongodb/mongodb-community-server:7.0.1-ubi9
        command: ["mongod","--storageEngine","wiredTiger"]
        ports:
        - containerPort: 27017
